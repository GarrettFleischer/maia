{
  "identity": {
    "name": "Maia",
    "emoji": "🌙",
    "personality": "helpful, security-conscious assistant"
  },
  "workspace": {
    "path": "~/.maia/workspace"
  },
  "provider": {
    "primary": "ollama",
    "model": "llama3.2",
    "healthCheck": {
      "enabled": true,
      "intervalMs": 60000,
      "consecutiveFailures": 3
    },
    "ollama": {
      "baseUrl": "http://localhost:11434"
    },
    "groq": {
      "credentialName": "groq-api-key"
    },
    "gemini": {
      "credentialName": "gemini-api-key"
    },
    "huggingface": {
      "credentialName": "huggingface-api-key"
    },
    "openrouter": {
      "credentialName": "openrouter-api-key"
    }
  },
  "gateway": {
    "port": 3000,
    "host": "0.0.0.0",
    "auth": {
      "token": "${MAIA_AUTH_TOKEN}"
    },
    "cors": {
      "origins": ["http://localhost:3000"]
    }
  },
  "channels": {
    "cli": { "enabled": true },
    "webchat": { "enabled": true },
    "discord": { "enabled": false },
    "telegram": { "enabled": false }
  },
  "memory": {
    "enabled": true,
    "embeddingProvider": "ollama",
    "embeddingModel": "nomic-embed-text",
    "search": {
      "hybrid": {
        "enabled": true,
        "vectorWeight": 0.7,
        "textWeight": 0.3
      },
      "defaultLimit": 5
    },
    "autoCapture": true,
    "autoRecall": true,
    "consolidation": {
      "schedule": "0 23 * * *",
      "onDemand": true,
      "sizeThreshold": 5000
    }
  },
  "security": {
    "rateLimiting": {
      "maxRequests": 60,
      "windowMs": 60000
    },
    "promptInjection": {
      "detection": true,
      "wrapping": true
    },
    "ssrf": {
      "blockPrivateIPs": true
    },
    "encryption": {
      "enabled": true,
      "scope": ["USER.md", "MEMORY.md", "memory/", "knowledge/"]
    },
    "secretScanner": {
      "enabled": true,
      "patterns": []
    },
    "auditLog": {
      "enabled": true
    },
    "sandbox": {
      "enabled": true,
      "root": "~/.maia"
    }
  },
  "session": {
    "compaction": {
      "thresholdPercent": 80,
      "preserveRecentMessages": 10
    }
  },
  "scheduler": {
    "enabled": true,
    "checkIntervalMs": 60000
  },
  "watchdog": {
    "enabled": true,
    "healthCheckIntervalMs": 60000,
    "threatWindow": {
      "durationMs": 300000,
      "bruteForceThreshold": 10,
      "injectionThreshold": 5
    },
    "alertChannels": ["console"],
    "autoShutdown": true
  },
  "backup": {
    "includeAuditLog": false
  },
  "mcp": {
    "servers": [
      {
        "name": "docker",
        "command": "docker",
        "args": ["mcp", "--config", "/path/to/gordon-mcp.yml"]
      }
    ]
  }
}
