{
  "name": "maia",
  "version": "0.1.0",
  "description": "Security-focused personal AI assistant with four-tier memory and free LLM support",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "maia": "src/index.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts start",
    "chat": "bun run src/index.ts chat",
    "onboard": "bun run src/index.ts onboard",
    "credentials": "bun run src/index.ts credentials",
    "backup": "bun run src/index.ts backup",
    "restore": "bun run src/index.ts restore",
    "schedule": "bun run src/index.ts schedule",
    "watchdog": "bun run src/index.ts watchdog",
    "doctor": "bun run src/index.ts doctor",
    "help": "bun run src/index.ts -- --help",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun run scripts/check-coverage.ts",
    "typecheck": "bunx tsc --noEmit",
    "compile": "bun build src/index.ts --compile --outfile=maia"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "typescript": "^5.9.3"
  }
}
