# Maia AI Assistant - Environment Variables
# Copy this file to .env and fill in your values

# Gateway authentication token (required for HTTP/WebSocket API)
MAIA_AUTH_TOKEN=your-secret-token-here

# Log level (debug, info, warn, error)
MAIA_LOG_LEVEL=info

# Override config file path (optional)
# MAIA_CONFIG=~/.maia/maia.config.json

# Override workspace path (optional)
# MAIA_WORKSPACE=~/.maia/workspace
