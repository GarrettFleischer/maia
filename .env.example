# Maia API key. Required for API auth. Use in Authorization: Bearer <key>.
# Leave empty in development to allow requests without a key.
MAIA_API_KEY=

# Optional. Log level: debug | info | warn | error. Default: info.
# Set to debug to log heartbeat, timers, tool calls, and LLM prompts/responses.
# MAIA_LOG_LEVEL=info

# Optional. Base path for agent data and DB. Default: ~/.maia
# MAIA_HOME=~/.maia

# Optional. SQLite database path. Default: ${MAIA_HOME}/maia.sqlite
# MAIA_DB_PATH=

# Optional. Heartbeat tick interval in milliseconds (settings API).
# MAIA_HEARTBEAT_INTERVAL_MS=60000

# Optional. Key for encrypting stored secrets. Defaults to MAIA_API_KEY if unset.
# MAIA_SECRETS_ENCRYPTION_KEY=

# Ollama API base URL. Default: http://127.0.0.1:11434
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Ollama model for chat/completion. Default: llama3
# OLLAMA_DEFAULT_MODEL=llama3

# Optional. Ollama model for the pre-LLM security gate (classifier). When unset, the gate is
# disabled and all chats are allowed. Set to a model name (e.g. llama3) to enable the gate.
# OLLAMA_SECURITY_GATE_MODEL=llama3

# Optional. Enable thinking/reasoning for compatible models (e.g. deepseek-r1, qwen3).
# Set to true, 1, or yes to enable; false, 0, or no to disable. Default: not set (disabled).
# OLLAMA_THINK=true

# Optional. Thinking level for GPT-OSS: low, medium, or high. Ignored if OLLAMA_THINK is not enabled.
# OLLAMA_THINK_LEVEL=medium

# Optional. Context length in tokens (Ollama options.num_ctx). Overrides model default when set.
# OLLAMA_NUM_CTX=8192

# Optional. Ollama cloud API key. When set, enables web_search and web_fetch tools (get key from https://ollama.com/settings/keys).
# OLLAMA_API_KEY=

# Optional. When true, 1, or yes, assistant replies are streamed (NDJSON deltas). When unset or false, the server
# waits for the full LLM response (including thinking and tool calls) then sends a single done line. Default: false.
# MAIA_LLM_STREAMING=false
