# Maia AI Assistant - Environment Variables
# Copy this file to .env and fill in your values

# Gateway authentication token (required for HTTP/WebSocket API)
MAIA_AUTH_TOKEN=your-secret-token-here

# Master key for encrypting the credential vault (required)
# Use any strong passphrase. A 32-byte key will be derived from it via scrypt.
# If not set, 'maia onboard' will generate one automatically.
MAIA_MASTER_KEY=your-master-passphrase-here

# Log level (debug, info, warn, error)
MAIA_LOG_LEVEL=info

# Override config file path (optional)
# MAIA_CONFIG=~/.maia/maia.config.json

# Override workspace path (optional)
# MAIA_WORKSPACE=~/.maia/workspace
